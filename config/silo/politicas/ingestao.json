{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "IngestaoApenasEscreveNaLanding",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucket", "s3:PutObject",
                 "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
      "Resource": ["arn:aws:s3:::landing", "arn:aws:s3:::landing/*"]
    }
  ]
}
