{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PipelineLeEscreveTodasAsCamadas",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation", "s3:ListBucket", "s3:ListBucketMultipartUploads",
        "s3:GetObject", "s3:PutObject", "s3:DeleteObject",
        "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::landing", "arn:aws:s3:::landing/*",
        "arn:aws:s3:::bronze",  "arn:aws:s3:::bronze/*",
        "arn:aws:s3:::silver",  "arn:aws:s3:::silver/*",
        "arn:aws:s3:::gold",    "arn:aws:s3:::gold/*"
      ]
    }
  ]
}
