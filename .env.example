# =============================================================
# Configuração do ambiente — copie para .env com: make env
# Valores __GENERATE__ são substituídos por senhas aleatórias.
# NUNCA versione o arquivo .env
# =============================================================

COMPOSE_PROJECT_NAME=case-saude
# Profiles ativos: core, stream, processing, speed, orchestration, bi, observability
# (o profile "simulation", do gerador de eventos, é ligado sob demanda: make gerador-start)
COMPOSE_PROFILES=core,stream,processing,speed,orchestration,bi,observability

# ---------- PostgreSQL ----------
POSTGRES_USER=admin
POSTGRES_PASSWORD=__GENERATE__
POSTGRES_PORT=5432
# Usuários dedicados por banco (menor privilégio)
AIRFLOW_DB_PASSWORD=__GENERATE__
DW_DB_PASSWORD=__GENERATE__
OLTP_DB_PASSWORD=__GENERATE__
METABASE_DB_PASSWORD=__GENERATE__
# Usuário somente leitura do BI (acessa apenas o schema gold do DW)
BI_READER_PASSWORD=__GENERATE__
# Usuário somente leitura de estatísticas (postgres-exporter)
MONITORING_DB_PASSWORD=__GENERATE__

# ---------- Silo (fork comunitário do MinIO) — data lake ----------
# O Silo mantém as variáveis MINIO_* por compatibilidade
MINIO_ROOT_USER=lakeadmin
MINIO_ROOT_PASSWORD=__GENERATE__
# Chave mestra do KMS (criptografia em repouso dos objetos)
SILO_KMS_KEY=__KMS__
# Usuários de serviço com menor privilégio por camada do lakehouse
SILO_PIPELINE_SECRET=__GENERATE__
SILO_INGESTAO_SECRET=__GENERATE__
SILO_ANALISTA_SECRET=__GENERATE__
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------- Kafka ----------
KAFKA_EXTERNAL_PORT=9094
KAFKA_UI_PORT=8082
KAFKA_UI_PASSWORD=__GENERATE__
KAFKA_CONNECT_PORT=8083

# ---------- Spark ----------
SPARK_MASTER_PORT=7077
SPARK_MASTER_UI_PORT=8081
# Escala horizontal: número de workers e recursos de cada um
SPARK_WORKER_REPLICAS=2
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2g
# Interface do job de streaming (aba "Structured Streaming")
SPARK_STREAMING_UI_PORT=4040
# Núcleos do cluster reservados à speed layer
SPARK_STREAMING_CORES=2
# Intervalo do micro-batch da speed layer (equilíbrio entre latência e vazão)
SPEED_INTERVALO_LOTE="30 seconds"

# ---------- Gerador de eventos simulados ----------
GERADOR_EVENTOS_POR_SEGUNDO=50
GERADOR_TAXA_INVALIDOS=0.01
# Operações por segundo no prontuário (fonte do CDC); 0 desliga
GERADOR_PRONTUARIO_OPS=2

# Geração dos checkpoints do streaming (alterada por: make streaming-recomecar)
STREAMING_GERACAO=1
SPEED_OFFSETS_INICIAIS=earliest

# ---------- Batch layer ----------
# Anos do SRAG (OpenDataSUS) carregados. Todos os disponíveis: 2019,2020,2021,2022,2023,2024,2025,2026
SRAG_ANOS=2024,2025,2026

# ---------- Airflow ----------
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=__GENERATE__
# Criptografia das conexões salvas no Airflow e assinatura dos tokens da API
AIRFLOW_FERNET_KEY=__FERNET__
AIRFLOW_JWT_SECRET=__GENERATE__

# ---------- BI ----------
METABASE_PORT=3000
# Portal da plataforma (página de acompanhamento para o usuário)
PORTAL_PORT=8090
# Senha do usuário "portal" no Airflow (papel Viewer, somente leitura)
AIRFLOW_PORTAL_PASSWORD=__GENERATE__
# Administrador do Metabase: criado automaticamente numa instalação nova (make metabase).
# Numa instalação já configurada, informe aqui o e-mail e a senha do administrador existente.
METABASE_ADMIN_EMAIL=admin@case-saude.local
METABASE_ADMIN_PASSWORD=__GENERATE__
# Assinatura das sessões do Metabase (alterar desconecta todos os usuários)
METABASE_SESSION_SECRET=__GENERATE__
# Criptografia das credenciais salvas no Metabase
METABASE_ENCRYPTION_KEY=__GENERATE__

# ---------- Observabilidade ----------
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=__GENERATE__
PROMETHEUS_PORT=9090

# ---------- Segurança / LGPD ----------
# Chave usada no HMAC-SHA256 para pseudonimizar CPF e outros identificadores
PII_HMAC_KEY=__GENERATE__
